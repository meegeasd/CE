# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_IDS=860835914,123456789
CHANNEL_HANDLE=@CapXpert
CHANNEL_NAME=کپیتال اکسپرت
CHANNEL_ID=-1003733210829

# Glass Buttons (format: name1|url1,name2|url2)
GLASS_BUTTONS=وب‌سایت|https://capxpert.com,اینستاگرام|https://instagram.com/capxpert,تلگرام|https://t.me/CapXpert

# Proxy Configuration (optional on Railway if not in Iran)
# PROXY=socks5://127.0.0.1:3067
# PROXY_FALLBACKS=http://127.0.0.1:3067,socks5://127.0.0.1:10808,http://127.0.0.1:10808,http://127.0.0.1:10809,socks5://127.0.0.1:10809,http://127.0.0.1:7890
AUTO_DETECT_PROXY=true
TRY_DIRECT_FETCH=true

# Price Source Priority (higher = more trusted)
# Options: tgju, do_l4, yahoo, coingecko, tsetmc, coinmarketcap
PRICE_SOURCE_PRIORITY=tgju,do_l4,yahoo,coingecko,tsetmc

# API Keys for Price Sources (optional but recommended for reliability)
TGJU_API_KEY=your_tgju_api_key
TSETMC_API_KEY=your_tsetmc_api_key
COINGECKO_API_KEY=your_coingecko_pro_key
COINMARKETCAP_API_KEY=your_coinmarketcap_key

# CryptoPanic for news
CRYPTOPANIC_KEY=your_cryptopanic_key

# Cloudflare Workers AI (for news filtering - free tier)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
NEWS_POLL_INTERVAL=300

# Railway Deployment
# WEBHOOK_URL=https://your-app.up.railway.app/webhook  (set this in Railway dashboard)
PORT=8080
LOG_LEVEL=INFO

# Auto-post schedule (HH:MM format, comma-separated)
# AUTO_POST_TIMES=09:00,14:00,21:00